{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Daily store sales",
      "queryLines": [
        "SELECT sales_date, store_name, region, state, store_format, net_sales, transaction_count, daily_sales_target, rewards_share ",
        "FROM gold_daily_store_sales"
      ]
    },
    {
      "name": "ds_dept",
      "displayName": "Department sales",
      "queryLines": [
        "SELECT sales_date, department, category, net_sales, units_sold ",
        "FROM gold_department_sales"
      ]
    },
    {
      "name": "ds_alerts",
      "displayName": "Store review list",
      "queryLines": [
        "SELECT store_name, region, net_sales, target_sales, attainment_pct / 100 AS attainment, status, ",
        "CASE WHEN status = 'UNDERPERFORMING' THEN 1 ELSE 0 END AS is_underperforming ",
        "FROM gold_store_alerts ORDER BY attainment_pct"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Store Performance\n",
                "\n",
                "Net sales and target attainment across Fresh Market stores. Deployed from the **fresh_market_dabs_lab** bundle."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi-net-sales",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "sum(net_sales)",
                      "expression": "SUM(`net_sales`)"
                    },
                    {
                      "name": "weekly(sales_date)",
                      "expression": "DATE_TRUNC(\"WEEK\", `sales_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(net_sales)",
                  "displayName": "Net Sales",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "period": {
                  "fieldName": "weekly(sales_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Net Sales"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-transactions",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "sum(transaction_count)",
                      "expression": "SUM(`transaction_count`)"
                    },
                    {
                      "name": "weekly(sales_date)",
                      "expression": "DATE_TRUNC(\"WEEK\", `sales_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(transaction_count)",
                  "displayName": "POS Line Items",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "period": {
                  "fieldName": "weekly(sales_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "POS Line Items"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-underperforming",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_alerts",
                  "fields": [
                    {
                      "name": "sum(is_underperforming)",
                      "expression": "SUM(`is_underperforming`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(is_underperforming)",
                  "displayName": "Stores Below Target"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Stores Flagged for Review",
                "showDescription": true,
                "description": "From the latest so_store_kpis run"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "line-sales-by-state",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "weekly(sales_date)",
                      "expression": "DATE_TRUNC(\"WEEK\", `sales_date`)"
                    },
                    {
                      "name": "sum(net_sales)",
                      "expression": "SUM(`net_sales`)"
                    },
                    {
                      "name": "state",
                      "expression": "`state`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "weekly(sales_date)",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Week"
                },
                "y": {
                  "fieldName": "sum(net_sales)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Net Sales",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "color": {
                  "fieldName": "state",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "State"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Weekly Net Sales by State"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "bar-sales-by-department",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_dept",
                  "fields": [
                    {
                      "name": "department",
                      "expression": "`department`"
                    },
                    {
                      "name": "sum(net_sales)",
                      "expression": "SUM(`net_sales`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "sum(net_sales)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Net Sales",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "y": {
                  "fieldName": "department",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "x-reversed"
                    }
                  },
                  "displayName": "Department"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Net Sales by Department"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "table-store-review",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_alerts",
                  "fields": [
                    {
                      "name": "store_name",
                      "expression": "`store_name`"
                    },
                    {
                      "name": "region",
                      "expression": "`region`"
                    },
                    {
                      "name": "net_sales",
                      "expression": "`net_sales`"
                    },
                    {
                      "name": "target_sales",
                      "expression": "`target_sales`"
                    },
                    {
                      "name": "attainment",
                      "expression": "`attainment`"
                    },
                    {
                      "name": "status",
                      "expression": "`status`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "store_name",
                    "displayName": "Store"
                  },
                  {
                    "fieldName": "region",
                    "displayName": "Region"
                  },
                  {
                    "fieldName": "net_sales",
                    "displayName": "Net Sales",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "USD",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 1
                      }
                    }
                  },
                  {
                    "fieldName": "target_sales",
                    "displayName": "Target",
                    "format": {
                      "type": "number-currency",
                      "currencyCode": "USD",
                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 1
                      }
                    }
                  },
                  {
                    "fieldName": "attainment",
                    "displayName": "Attainment",
                    "format": {
                      "type": "number-percent",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 1
                      }
                    }
                  },
                  {
                    "fieldName": "status",
                    "displayName": "Status"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Store Review List (worst attainment first)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 11,
            "width": 12,
            "height": 7
          }
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {
        "light": "#FCFCFC",
        "dark": "#1F272D"
      },
      "widgetBackgroundColor": {
        "light": "#FFFFFF",
        "dark": "#11171C"
      },
      "widgetBorderColor": {
        "light": "#FFFFFF",
        "dark": "#11171C"
      },
      "fontColor": {
        "light": "#11171C",
        "dark": "#E8ECF0"
      },
      "selectionColor": {
        "light": "#2272B4",
        "dark": "#8ACAFF"
      },
      "visualizationColors": [
        "#0072B2",
        "#E69F00",
        "#009E73",
        "#CC79A7",
        "#D55E00",
        "#56B4E9",
        "#F0E442"
      ],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}